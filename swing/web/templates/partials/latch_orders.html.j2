{# Phase 21 Arc A: the lazy broker-order-awareness fragment.

   Fragment root is a <section>, NOT a <tr>: an HTMX response leading with
   <tr> triggers makeFragment's synthetic-table-wrap, which DROPS <table>
   content inside OOB <section> chunks (browser-only; TestClient cannot see
   it). ASCII only. #}
<section class="latch-orders-block">
  {% if not vm.available %}
  <p class="latch-orders-degraded">
    Broker order book UNKNOWN: {{ vm.resolution_detail }}
  </p>
  {% else %}
  {% if vm.alarms %}
  <div class="latch-alarms">
    {% for alarm in vm.alarms %}
    <p class="latch-alarm{% if alarm.severity != 'critical' %} latch-alarm-warning{% endif %}">
      <strong>{{ alarm.kind }}</strong> ({{ alarm.severity }}) {{ alarm.ticker }}:
      {{ alarm.detail }}
    </p>
    {% endfor %}
  </div>
  {% elif not vm.disagreements and not vm.indeterminate_tickers
          and not vm.multiplicity_notes and not vm.shape_check_skipped %}
  <p class="muted">Broker orders agree with the live latches. No alarms.</p>
  {% endif %}

  {# The mandate REGIME was undeterminable, so the two-form order-shape check
     did not run and BOTH forms were accepted. That is a real reduction in what
     the panel is asserting, so it is LABELLED on the affected latch -- an
     unlabelled reduction is a quiet all-clear by omission. A latch whose ticker
     has left the screen is permanently in this state, and this is what makes it
     VISIBLY rather than silently inert. #}
  {% if vm.shape_check_skipped %}
  <div class="latch-shape-check-skipped">
    {% for line in vm.shape_check_skipped %}
    <p class="latch-alarm latch-alarm-warning">
      <strong>ORDER SHAPE CHECK NOT RUN</strong> {{ line }}
    </p>
    {% endfor %}
  </div>
  {% endif %}

  {# MORE THAN ONE order matched a single mandate. The agreement flags describe
     ONE reference order, so the affirmative agree is WITHHELD and the
     multiplicity stated instead -- a fully-agreeing order must never be able to
     print an all-clear over an uninspected sibling. #}
  {% if vm.multiplicity_notes %}
  <div class="latch-multiplicity">
    {% for line in vm.multiplicity_notes %}
    <p class="latch-alarm latch-alarm-warning">
      <strong>MULTIPLE ORDERS MATCH THIS MANDATE</strong> {{ line }}
    </p>
    {% endfor %}
  </div>
  {% endif %}

  {# An INDETERMINATE broker status suppresses both alarms by design. That
     suppression must be VISIBLE, or the silence reads as an all-clear. #}
  {% if vm.indeterminate_tickers %}
  <div class="latch-indeterminate">
    {% for ticker in vm.indeterminate_tickers %}
    <p class="latch-alarm latch-alarm-warning">
      <strong>ORDER STATUS INDETERMINATE</strong> {{ ticker }}: order status
      indeterminate - verify at the broker. Alarms are suppressed for this
      ticker.
    </p>
    {% endfor %}
  </div>
  {% endif %}

  {# A wrong-price resting order SILENCES the ticker-level "no order" alarm, so
     it must be rendered loudly or the page reads as an all-clear over a mandate
     that is not actually covered. #}
  {% if vm.disagreements %}
  <div class="latch-disagreements">
    {% for line in vm.disagreements %}
    <p class="latch-alarm latch-alarm-warning">
      <strong>ORDER PRICE MISMATCH</strong> {{ line }}
    </p>
    {% endfor %}
  </div>
  {% endif %}

  {% if vm.order_lines %}
  <details class="latch-order-list">
    <summary>Resting BUY orders ({{ vm.order_lines | length }})</summary>
    <ul>
      {% for line in vm.order_lines %}
      <li>{{ line }}</li>
      {% endfor %}
    </ul>
  </details>
  {% else %}
  <p class="muted">No resting BUY orders at the broker.</p>
  {% endif %}
  {% endif %}
</section>
