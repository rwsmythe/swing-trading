{# Phase 21 Arc A: the lazy broker-order-awareness fragment.

   Fragment root is a <section>, NOT a <tr>: an HTMX response leading with
   <tr> triggers makeFragment's synthetic-table-wrap, which DROPS <table>
   content inside OOB <section> chunks (browser-only; TestClient cannot see
   it). ASCII only. #}
<section class="latch-orders-block">
  {% if not vm.available %}
  <p class="latch-orders-degraded">
    Broker order book UNKNOWN: {{ vm.resolution_detail }}
  </p>
  {% else %}
  {% if vm.alarms %}
  <div class="latch-alarms">
    {% for alarm in vm.alarms %}
    <p class="latch-alarm{% if alarm.severity != 'critical' %} latch-alarm-warning{% endif %}">
      <strong>{{ alarm.kind }}</strong> ({{ alarm.severity }}) {{ alarm.ticker }}:
      {{ alarm.detail }}
    </p>
    {# THE PER-ORDER CANCEL CONTROL on a stale-order alarm. LOG-ONLY: nothing is
       sent to the broker on any branch -- the operator still cancels at the
       broker, and this records that he decided to. Without it a `cancel` intent
       is unreachable in a browser, so the row that carries section G.4's EXACT
       linkage (a captured broker order id) never enters the ledger.

       It targets a SPECIFIC broker order id, never a ticker: hazard (c), and
       the schema CHECK makes a ticker-aimed cancel unwritable. #}
    {% if alarm.broker_order_id and alarm.latch_candidate_id %}
    <form class="latch-cancel-form" hx-post="/latches/intent"
          hx-target="this" hx-swap="outerHTML"
          hx-headers='{"HX-Request": "true"}'>
      <input type="hidden" name="intent_kind" value="cancel">
      <input type="hidden" name="candidate_id"
             value="{{ alarm.latch_candidate_id }}">
      <input type="hidden" name="view_session_date"
             value="{{ vm.view_session_date }}">
      <input type="hidden" name="actual_broker_order_id"
             value="{{ alarm.broker_order_id }}">
      <input type="hidden" name="prior_intent_id"
             value="{{ alarm.prior_intent_id }}">
      <button type="submit" class="latch-cancel-submit">Log that I cancelled
        order {{ alarm.broker_order_id }}</button>
    </form>
    {% elif alarm.cancel_unavailable_note %}
    <p class="latch-cancel-unavailable">{{ alarm.cancel_unavailable_note }}</p>
    {% endif %}
    {% endfor %}
  </div>
  {% elif not vm.disagreements and not vm.indeterminate_tickers
          and not vm.multiplicity_notes %}
  {# The page-level claims, SEPARATED (B6, Arc 21-B, superseding the single
     SCOPED sentence of RD's 2026-07-28 ruling). A disagreement / indeterminate
     status / multiplicity is a FINDING and still withholds every claim
     entirely; a check that did not RUN is not a finding, so it is stated as its
     OWN claim rather than by suppressing the alarm all-clear -- which is
     COMPLETE and unscoped, because alarms, the cap leg, GTC duration and the
     stray-order sweep run on EVERY latch. Stating the reduction beats
     suppressing the claim: the not-run label is the default state for ~7 hours
     of every trading day, and an all-clear the operator essentially never sees
     stops being informative by its absence. `vm.all_clear_note` is
     display-ready (the joined `vm.all_clear_claims`); this template holds no
     logic. #}
  <p class="muted">{{ vm.all_clear_note }}</p>
  {% endif %}

  {# The mandate REGIME was undeterminable, so the two-form order-shape check
     did not run and BOTH forms were accepted. That is a real reduction in what
     the panel is asserting, so it is LABELLED on the affected latch -- an
     unlabelled reduction is a quiet all-clear by omission.

     ONE rendering path, per-branch TONE (RD ruling 2026-07-28). `pending` means
     NO usable close has been recorded for the derivation session yet: it is the
     DEFAULT state for ~7 hours of every trading day, the operator's response is
     simply to wait, and a warning-shaped label on a daily state trains the
     dismissal reflex on the one surface whose alarms must survive being
     believed. So it renders as neutral status. `permanent` (that session's
     closes exist and this latch has none of them -- usually because the ticker
     is no longer evaluated, though nothing here can SEE finviz-screen
     membership) and `unknown` keep the warning tone, because the nightly is not
     what they are waiting on. #}
  {% if vm.mandate_form_check_skipped %}
  <div class="latch-form-check-skipped">
    {% for note in vm.mandate_form_check_skipped %}
    <p class="{% if note.severity in ('pending', 'stale_regime') %}latch-form-check-pending{% else %}latch-alarm latch-alarm-warning{% endif %}">
      <strong>{{ note.headline }}</strong> {{ note.detail }}
    </p>
    {% endfor %}
  </div>
  {% endif %}

  {# MORE THAN ONE order matched a single mandate. The agreement flags describe
     ONE reference order, so the affirmative agree is WITHHELD and the
     multiplicity stated instead -- a fully-agreeing order must never be able to
     print an all-clear over an uninspected sibling. #}
  {% if vm.multiplicity_notes %}
  <div class="latch-multiplicity">
    {% for line in vm.multiplicity_notes %}
    <p class="latch-alarm latch-alarm-warning">
      <strong>MULTIPLE ORDERS MATCH THIS MANDATE</strong> {{ line }}
    </p>
    {% endfor %}
  </div>
  {% endif %}

  {# An INDETERMINATE broker status suppresses both alarms by design. That
     suppression must be VISIBLE, or the silence reads as an all-clear. #}
  {% if vm.indeterminate_tickers %}
  <div class="latch-indeterminate">
    {% for ticker in vm.indeterminate_tickers %}
    <p class="latch-alarm latch-alarm-warning">
      <strong>ORDER STATUS INDETERMINATE</strong> {{ ticker }}: order status
      indeterminate - verify at the broker. Alarms are suppressed for this
      ticker.
    </p>
    {% endfor %}
  </div>
  {% endif %}

  {# A wrong-price resting order SILENCES the ticker-level "no order" alarm, so
     it must be rendered loudly or the page reads as an all-clear over a mandate
     that is not actually covered. #}
  {% if vm.disagreements %}
  <div class="latch-disagreements">
    {% for line in vm.disagreements %}
    <p class="latch-alarm latch-alarm-warning">
      <strong>ORDER PRICE MISMATCH</strong> {{ line }}
    </p>
    {% endfor %}
  </div>
  {% endif %}

  {# THE VALIDITY PROMPT (Arc 21-B, plan section F.3). This fragment is the ONLY
     surface that can ask it: the presence/absence branch needs the LIVE broker
     book, `GET /latches` has none and must not acquire any (A4), and
     `POST /latches/intent` is forbidden from borrowing the Schwab client -- so
     the prompt is rendered HERE and the intent route merely RECORDS the answer.

     `vm.validity_prompts` is EMPTY on an unavailable book, because this whole
     branch is inside `vm.available` -- a prompt built on an unknown order book
     invites an answer the operator would infer from the panel's own silence.

     EVERY VALUE IS DISPLAY-READY. The form root is a `section`, never a `tr`
     (the makeFragment synthetic-table-wrap gotcha); it carries its OWN
     `hx-target="this"` because hx-target INHERITS from ancestors; and
     `hx-headers` with HX-Request is what keeps OriginGuard strict mode from
     403-ing an unsafe method. ASCII only. #}
  {# A FAILED COLLECTOR IS NOT AN ABSENT QUESTION. Without this line a prompt
     that could not be BUILT renders identically to a latch with nothing to ask,
     and the agreement denominator stays empty for a reason nobody can see --
     which is this arc's own failure mode pointed at its own instrument. #}
  {% if vm.validity_prompt_degraded %}
  <p class="latch-alarm latch-alarm-warning latch-validity-degraded">
    {{ vm.validity_prompt_degraded }}
  </p>
  {% endif %}
  {% for prompt in vm.validity_prompts %}
  <section class="latch-validity-prompt latch-validity-{{ prompt.branch }}">
    {% if prompt.is_correction %}
    <h4 class="latch-validity-heading">CORRECT THE RECORDED OUTCOME:
      {{ prompt.ticker }}</h4>
    <p class="latch-validity-correction">This latch is already recorded as
      <strong>{{ prompt.superseded_outcome }}</strong>. If that is wrong, answer
      again - the ledger is append-only, so a correction is a NEW row and your
      LATEST answer governs. Nothing is overwritten.</p>
    {% else %}
    <h4 class="latch-validity-heading">DID THIS ORDER REACH THE BROKER?
      {{ prompt.ticker }}</h4>
    {% endif %}
    <p class="latch-validity-headline">{{ prompt.headline }}</p>
    {% if prompt.divergence_note %}
    <p class="latch-validity-divergence">{{ prompt.divergence_note }}</p>
    {% endif %}
    {% if prompt.incomplete_note %}
    <p class="latch-validity-incomplete">{{ prompt.incomplete_note }}</p>
    {% endif %}

    {# TWO FORMS, NOT ONE RADIO GROUP. The model and the migration both require
       that a NON-accepted validity row carry NO observed order at all -- an
       outcome and its evidence must not be able to disagree -- so a single form
       emitting the observed side beside all four options was UNWRITABLE for
       three of them and every click 400d against the ledger contract. The
       observed side therefore rides on its OWN confirm form. #}
    {% if prompt.confirm_available %}
    <form class="latch-validity-form latch-validity-confirm"
          hx-post="/latches/intent" hx-target="this" hx-swap="outerHTML"
          hx-headers='{"HX-Request": "true"}'>
      <input type="hidden" name="intent_kind" value="validity">
      <input type="hidden" name="candidate_id" value="{{ prompt.candidate_id }}">
      <input type="hidden" name="view_session_date"
             value="{{ prompt.view_session_date }}">
      <input type="hidden" name="validated_place_intent_id"
             value="{{ prompt.parent_place_intent_id }}">
      <input type="hidden" name="broker_snapshot_json"
             value="{{ prompt.snapshot_json }}">
      <input type="hidden" name="prior_intent_id"
             value="{{ prompt.prior_intent_id }}">
      <input type="hidden" name="validity_outcome" value="accepted_by_broker">
      {% for name, value in prompt.actual_fields %}
      <input type="hidden" name="{{ name }}" value="{{ value }}">
      {% endfor %}
      <button type="submit" class="latch-validity-submit">{{
        prompt.confirm_label }}</button>
    </form>
    {% endif %}

    <form class="latch-validity-form latch-validity-other"
          hx-post="/latches/intent" hx-target="this" hx-swap="outerHTML"
          hx-headers='{"HX-Request": "true"}'>
      <input type="hidden" name="intent_kind" value="validity">
      <input type="hidden" name="candidate_id" value="{{ prompt.candidate_id }}">
      <input type="hidden" name="view_session_date"
             value="{{ prompt.view_session_date }}">
      <input type="hidden" name="validated_place_intent_id"
             value="{{ prompt.parent_place_intent_id }}">
      {# ONE canonical hidden field carrying the WHOLE snapshot envelope, never
         separate per-key inputs: `validity_detail` requires the full envelope
         and the handler is forbidden from reconstructing a missing key. #}
      <input type="hidden" name="broker_snapshot_json"
             value="{{ prompt.snapshot_json }}">
      <input type="hidden" name="prior_intent_id"
             value="{{ prompt.prior_intent_id }}">
      {% for value, label in prompt.options %}
      <label class="latch-validity-option">
        <input type="radio" name="validity_outcome" value="{{ value }}">
        {{ label }}
      </label>
      {% endfor %}
      <button type="submit" class="latch-validity-submit">Record this
        outcome</button>
    </form>
  </section>
  {% endfor %}

  {% if vm.order_lines %}
  <details class="latch-order-list">
    <summary>Resting BUY orders ({{ vm.order_lines | length }})</summary>
    <ul>
      {% for line in vm.order_lines %}
      <li>{{ line }}</li>
      {% endfor %}
    </ul>
  </details>
  {% else %}
  <p class="muted">No resting BUY orders at the broker.</p>
  {% endif %}
  {% endif %}
</section>
